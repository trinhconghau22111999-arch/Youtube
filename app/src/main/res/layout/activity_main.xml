<?xml version="1.0" encoding="utf-8"?>
<!-- Root là FrameLayout để FloatingNavBar có thể nổi tự do ở mọi vị trí -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wp_black">


    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Màn hình chính (homeOverlay) nổi đè lên WebView - nền ĐEN ĐẶC theo yêu cầu (không còn
         ảnh nền/wallpaper tuỳ chỉnh nữa). -->
    <FrameLayout
        android:id="@+id/homeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

    </FrameLayout>

    <!-- ĐÃ XOÁ HẲN: nút toggle desktop/mobile (User-Agent tuỳ chỉnh) theo yêu cầu. -->

    <!-- ĐÃ XOÁ HẲN: thanh nhập URL ẩn (toolbarUrl/edtUrl) theo yêu cầu - không còn cách nào gõ
         tay 1 địa chỉ web trong màn hình chính nữa, chỉ còn 2 icon cố định (YouTube, Ẩn danh). -->

</FrameLayout>
