<?xml version="1.0" encoding="utf-8"?>
<!-- Root là FrameLayout để FloatingNavBar có thể nổi tự do ở mọi vị trí -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">


    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg" />

    <!-- Màn hình chính (homeOverlay) nổi đè lên WebView - LUÔN nền đen (@color/start_bg), bất kể
         theme hệ thống đang sáng hay tối. Trước đây dùng @color/app_bg (đổi theo theme: tối =
         đen, sáng = trắng/xám nhạt #F5F5F5) - giờ tách riêng ra màu start_bg cố định không có
         bản values-night/ ghi đè, để trang Start luôn đen dù máy đang ở chế độ sáng. -->
    <FrameLayout
        android:id="@+id/homeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/start_bg">

    </FrameLayout>

    <!-- ĐÃ XOÁ HẲN: nút toggle desktop/mobile (User-Agent tuỳ chỉnh) theo yêu cầu. -->

    <!-- ĐÃ XOÁ HẲN: thanh nhập URL ẩn (toolbarUrl/edtUrl) theo yêu cầu - không còn cách nào gõ
         tay 1 địa chỉ web trong màn hình chính nữa, chỉ còn 2 icon cố định (YouTube, Ẩn danh). -->

</FrameLayout>
