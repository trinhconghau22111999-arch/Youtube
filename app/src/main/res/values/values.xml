<resources>
    <string name="app_name">Tube for me</string>

    <!-- ================= BẢNG MÀU WINDOWS PHONE / WINDOWS 10 MOBILE (METRO) =================
         Giữ tên biến "neon_purple" để KHÔNG phải sửa hàng chục chỗ tham chiếu R.color trong
         code cũ (đổi tên sẽ vỡ build) - chỉ đổi GIÁ TRỊ màu sang "Cobalt Blue", màu accent mặc
         định kinh điển của Windows Phone/Windows 10. -->
    <color name="neon_purple">#0078D7</color>       <!-- Accent chính (Cobalt) -->
    <color name="pure_white">#FFFFFF</color>

    <!-- Accent hệ thống, dùng chung cho mọi màn hình thay vì @color/neon_purple từ giờ trở đi -->
    <color name="wp_accent">#0078D7</color>
    <color name="wp_black">#000000</color>

    <!-- Bo góc = 0 khắp nơi (Metro/Flat Design không có bo góc), áp cho MỌI component
         Material (nút, hộp thoại, thẻ...) trong toàn app chỉ bằng 3 dòng này. -->
    <style name="ShapeAppearance.WP.Flat" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Theme.AdBlockBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wp_black</item>
        <item name="colorPrimaryDark">@color/wp_black</item>
        <item name="colorAccent">@color/wp_accent</item>
        <item name="colorSecondary">@color/wp_accent</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <!-- FIX: trước đây hard-code cứng @color/pure_white (trắng tuyệt đối) trong khi
             windowBackground (@color/app_bg) lại TỰ ĐỔI theo theme hệ thống (đen lúc tối, gần
             trắng #F5F5F5 lúc sáng) - y hệt lỗi "chữ trắng trên nền trắng" đã tìm và sửa ở
             Theme.WP.Dialog bên dưới, nhưng theme CHÍNH của app lại bị bỏ sót chưa sửa. Đổi sang
             @color/app_text (đã có sẵn cặp day/night đúng, xem values/colors.xml và
             values-night/values.xml) để mọi chữ dùng màu mặc định của theme (không tự
             setTextColor riêng) luôn tương phản đúng với nền, không bị chìm mất khi máy đang ở
             chế độ Sáng. -->
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:statusBarColor">@color/wp_black</item>
        <item name="android:navigationBarColor">@color/wp_black</item>
        <!-- Font gần giống Segoe UI nhất có sẵn trên Android: mảnh, không chân -->
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="fontFamily">sans-serif-light</item>
        <!-- Bo góc = 0 cho toàn bộ nút/thẻ/hộp thoại Material trong app -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.WP.Flat</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.WP.Flat</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.WP.Flat</item>
        <!-- Bỏ hiệu ứng đổ bóng Material (elevation) - Metro là thiết kế PHẲNG tuyệt đối -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Giao diện hộp thoại PHẲNG kiểu Windows Phone: KHÔNG bo góc, nền/chữ tự đổi theo theme
         Sáng/Tối hệ thống (xem @color/app_bg, @color/app_text - values/colors.xml +
         values-night/values.xml), chữ nút bấm màu accent - dùng cho MỌI AlertDialog trong app
         qua AlertDialog.Builder(this, R.style.Theme_WP_Dialog) thay vì để hộp thoại tự vẽ theo
         style HỆ THỐNG mặc định (đa số máy ra nền trắng bo góc + nút xanh Google, phá vỡ hoàn
         toàn phong cách WP ngay khi có hộp thoại hiện lên - lỗi này trước đây có ở
         CalendarActivity, ClockActivity, FilesActivity vì dùng nhầm android.app.AlertDialog gốc
         thay vì bản có theme riêng - những Activity này không còn tồn tại trong app hiện tại,
         giữ lại ghi chú để biết gốc tích lỗi). -->
    <style name="Theme.WP.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/app_bg</item>
        <!-- FIX "chữ trong hộp thoại trắng trên nền trắng, không đọc được lúc nền sáng": trước
             đây textColor/textColorPrimary hard-code cứng @color/pure_white (trắng tuyệt đối)
             trong khi windowBackground (@color/app_bg) lại TỰ ĐỔI theo theme - đen lúc tối,
             #F5F5F5 (gần trắng) lúc sáng. Chữ trắng trên nền trắng gần như vô hình lúc theme
             sáng (đúng lỗi trong ảnh chụp: URL, "Mở trong tab mới", "Huỷ" đều mờ gần như không
             thấy). Đổi sang dùng @color/app_text/@color/app_text_secondary - 2 màu chữ vốn ĐÃ
             được định nghĩa sẵn theo cặp day/night y hệt app_bg (đen #111111 lúc nền sáng, trắng
             #FFFFFF lúc nền tối - xem values/colors.xml và values-night/values.xml) nhưng trước
             giờ chưa được dùng ở đây. -->
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorPrimary">@color/app_text</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <item name="colorAccent">@color/wp_accent</item>
        <item name="android:colorAccent">@color/wp_accent</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>
</resources>
